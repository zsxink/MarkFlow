      "taskCheckbox",
      "fence",
      "blockquote",
      "paragraph",
      "table",
      "frontmatter",
      "htmlBlock",
      "htmlComment",
      "htmlInline",
      "linkRefDef",
      "footnoteDefinition",
      "indentedCode"
    ]
  },
