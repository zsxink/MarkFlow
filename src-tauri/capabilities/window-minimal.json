{
  "identifier": "window-minimal-capability",
  "description": "Minimal shared capabilities — applied to all windows; main window gets additional permissions from main.json",
  "windows": ["*"],
  "permissions": [
    "core:default",
    "core:webview:allow-print",
    "core:window:allow-set-title",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-close",
    "dialog:allow-open",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    "dialog:allow-confirm"
  ]
}
